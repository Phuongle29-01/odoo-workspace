# Never point integration tests at production. Configure a staging instance first.
APP_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://workspace:CHANGE_LOCALLY@127.0.0.1:5433/workspace
ENCRYPTION_KEY=
SESSION_TTL_HOURS=8
SESSION_COOKIE_SECURE=false
ODOO_URL=
ODOO_PUBLIC_URL=
DOCKER_ODOO_URL=
ODOO_DB=
ODOO_VERSION=17
ODOO_HOSTING=unknown
ODOO_AUTH_MODE=password
ODOO_ALLOW_HTTP=false
ODOO_WRITE_ENABLED=false
# Local-only disposable Odoo; generated by npm run local:prepare, never committed.
LOCAL_POSTGRES_PASSWORD=
LOCAL_ODOO_ADMIN_PASSWORD=
LOCAL_TEST_PASSWORD_A=
LOCAL_TEST_PASSWORD_B=
